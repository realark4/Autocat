<UserControl x:Class="AutoCadAiPlugin.UI.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AutoCadAiPlugin.UI.Views"
             xmlns:conv="clr-namespace:AutoCadAiPlugin.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="400"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Themes.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}"
          FlowDirection="{Binding ChatFlowDirection}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Calm, compact header with clear product and connection hierarchy. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38"
                            Height="38"
                            Background="{StaticResource AccentGradientBrush}"
                            CornerRadius="11">
                        <TextBlock Text="A"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AUTOCAT"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Background="{StaticResource CardElevatedBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveProviderName}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="دستیار هوشمند طراحی در AutoCAD"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="8,6"
                            Margin="0,0,8,0"
                            ToolTip="وضعیت اتصال و عملیات جاری">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="90"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Content="＋"
                            Command="{Binding NewChatCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="گفت‌وگوی جدید"
                            Margin="0,0,6,0" />
                    <Button Content="↗"
                            Command="{Binding ExportChatCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="کپی خروجی Markdown"
                            Margin="0,0,6,0" />
                    <Button Content="⚙"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="تنظیمات اتصال" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="0"
                     Panel.ZIndex="3"
                     Height="2"
                     VerticalAlignment="Bottom"
                     IsIndeterminate="True"
                     Foreground="{StaticResource AccentBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Messages -->
        <ScrollViewer x:Name="MessagesScrollViewer"
                      Grid.Row="1"
                      Padding="16,18,16,8"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,14">
                            <!-- User message -->
                            <StackPanel HorizontalAlignment="Right"
                                        MaxWidth="330"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="شما"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,5" />
                                <Border Background="{StaticResource UserBubbleBrush}"
                                        CornerRadius="14,14,4,14"
                                        Padding="13,10">
                                    <TextBlock Text="{Binding Content}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="13"
                                               Foreground="#FFFFFF"
                                               TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,4,4,0" />
                            </StackPanel>

                            <!-- Assistant message and tool activity -->
                            <StackPanel HorizontalAlignment="Left"
                                        MaxWidth="350"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="28"
                                            Height="28"
                                            Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource AccentDeepBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="A"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <Grid Margin="2,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="AUTOCAT"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentHoverBrush}" />
                                                <TextBlock Text="  ·  "
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="کپی"
                                                    Command="{Binding CopyContentCommand}"
                                                    Style="{StaticResource TextButtonStyle}"
                                                    FontSize="9"
                                                    Padding="5,1"
                                                    MinHeight="20"
                                                    ToolTip="کپی پاسخ"
                                                    Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>

                                        <Border Background="{StaticResource AssistantBubbleBrush}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4,14,14,14"
                                                Padding="13,11"
                                                Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Content}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <Border Background="{StaticResource AssistantBubbleBrush}"
                                                BorderBrush="{StaticResource AccentDeepBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4,14,14,14"
                                                Padding="13,11"
                                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="در حال فکر کردن"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="  ·  تحلیل درخواست و برنامه‌ریزی ابزارها"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ProgressBar Height="3"
                                                             Margin="0,9,0,0"
                                                             IsIndeterminate="True"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             Background="{StaticResource CardBorderBrush}"
                                                             BorderThickness="0" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding ToolExecutions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:ToolExecutionCardView />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Quick actions -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10,14,9">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                    <TextBlock Text="شروع سریع"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="  ·  ترسیم، ویرایش و بررسی نقشه"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="مستطیل ۲۰۰ × ۱۰۰"
                                Command="{Binding QuickPromptCommand}"
                                CommandParameter="یک مستطیل 200 در 100 بکش"
                                Style="{StaticResource QuickPillButtonStyle}" />
                        <Button Content="سوراخ Ø۴۰ در مرکز"
                                Command="{Binding QuickPromptCommand}"
                                CommandParameter="وسط مستطیل یک سوراخ با قطر 40 ایجاد کن"
                                Style="{StaticResource QuickPillButtonStyle}" />
                        <Button Content="درج ابعاد"
                                Command="{Binding QuickPromptCommand}"
                                CommandParameter="روی مستطیل ابعاد اصلی را درج کن"
                                Style="{StaticResource QuickPillButtonStyle}" />
                        <Button Content="زوم کلی"
                                Command="{Binding QuickPromptCommand}"
                                CommandParameter="زوم کلی کن"
                                Style="{StaticResource QuickPillButtonStyle}" />
                        <Button Content="گزارش نقشه"
                                Command="{Binding QuickPromptCommand}"
                                CommandParameter="اطلاعات و خلاصه‌ای از نقشه فعلی بده"
                                Style="{StaticResource QuickPillButtonStyle}" />
                        <Button Content="بررسی انتخاب"
                                Command="{Binding QuickPromptCommand}"
                                CommandParameter="آبجکت‌های انتخاب‌شده را بررسی و مشخصاتشان را گزارش کن"
                                Style="{StaticResource QuickPillButtonStyle}" />
                        <Button Content="کپی ۵۰ واحد راست"
                                Command="{Binding QuickPromptCommand}"
                                CommandParameter="آبجکت انتخاب‌شده را 50 واحد به سمت راست کپی کن"
                                Style="{StaticResource QuickPillButtonStyle}" />
                        <Button Content="فیلت R20"
                                Command="{Binding QuickPromptCommand}"
                                CommandParameter="روی گوشه‌های آبجکت انتخاب‌شده فیلت با شعاع 20 اعمال کن"
                                Style="{StaticResource QuickPillButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Composer -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                Padding="14,3,14,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource InputBgBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                        <Grid>
                            <TextBox x:Name="ComposerTextBox"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     BorderThickness="0"
                                     Padding="12,10"
                                     MinHeight="44"
                                     AcceptsReturn="False"
                                     VerticalContentAlignment="Center"
                                     ToolTip="درخواست خود را برای ترسیم یا ویرایش بنویسید">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendMessageCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="مثلاً: یک پلان ۶×۴ با در و پنجره رسم کن..."
                                       Margin="13,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ComposerTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Content="ارسال  →"
                            Command="{Binding SendMessageCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="82"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <Button Grid.Column="1"
                            Content="توقف  ×"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Background="{StaticResource DangerBrush}"
                            Foreground="#FFFFFF"
                            MinWidth="82"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <Grid Margin="2,7,2,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Enter برای ارسال"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="تلاش مجدد"
                                Command="{Binding RetryLastMessageCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                FontSize="10"
                                Padding="7,2"
                                MinHeight="22"
                                Margin="8,0,0,0"
                                Visibility="{Binding CanRetryLastMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Content="پاک‌کردن"
                                Command="{Binding ClearChatCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                FontSize="10"
                                Padding="7,2"
                                MinHeight="22"
                                Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveModelName}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="130" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Settings modal -->
        <Border Grid.RowSpan="4"
                Panel.ZIndex="20"
                Background="{StaticResource OverlayBrush}"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:AiSettingsView DataContext="{Binding CurrentSettingsViewModel}"
                                  MaxWidth="440"
                                  MaxHeight="720"
                                  Margin="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Effect="{StaticResource DialogShadow}" />
        </Border>
    </Grid>
</UserControl>
