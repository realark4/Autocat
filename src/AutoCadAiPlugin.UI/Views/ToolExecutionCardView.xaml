<UserControl x:Class="AutoCadAiPlugin.UI.Views.ToolExecutionCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:AutoCadAiPlugin.UI.Converters"
             mc:Ignorable="d"
             d:DesignWidth="350"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Themes.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <conv:StatusToIconConverter x:Key="StatusToIconConverter" />
            <conv:StatusToLabelConverter x:Key="StatusToLabelConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="11"
            Padding="10"
            Margin="0,6,0,0"
            ToolTip="{Binding ToolName}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                    CornerRadius="2"
                    Margin="0,1,10,1" />

            <StackPanel Grid.Column="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding DisplayName}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,8,0" />
                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="6,3"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="10"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                       Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabelConverter}}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="9"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{StaticResource InputBgBrush}"
                        CornerRadius="7"
                        Padding="8,6"
                        Margin="0,8,0,0"
                        Visibility="{Binding HasArguments, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ArgumentsSummary}"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Border Background="#2A2116"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9,8"
                        Margin="0,9,0,0"
                        Visibility="{Binding RequiresApproval, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource WarningBrush}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="تأیید شما لازم است"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="این عملیات روی نقشه تغییر ایجاد می‌کند."
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="14,4,0,8" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="انصراف"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6"
                                    MinHeight="30"
                                    Margin="0,0,6,0" />
                            <Button Content="تأیید و اجرا"
                                    Command="{Binding ApproveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="11,6"
                                    MinHeight="30" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
