<UserControl x:Class="AutoCadAiPlugin.UI.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:AutoCadAiPlugin.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="430"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Themes.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource CardBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Modal header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="36"
                            Height="36"
                            Background="{StaticResource AccentGradientBrush}"
                            CornerRadius="11">
                        <Path Data="{StaticResource SettingsIconGeometry}"
                              Stroke="#FFFFFF"
                              StrokeThickness="1.35"
                              StrokeLineJoin="Round"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0"
                                VerticalAlignment="Center"
                                FlowDirection="RightToLeft">
                        <TextBlock Text="تنظیمات"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="اتصال، حریم خصوصی و ظاهر افزونه"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="بستن"
                        AutomationProperties.Name="بستن تنظیمات">
                    <Path Data="{StaticResource CloseIconGeometry}"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="16"
                          Height="16"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="1,0,3,0">
                <StackPanel>
                    <!-- Provider -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="13"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="مدل و سرویس"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="موتور پردازش درخواست‌های طراحی را انتخاب کنید."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,3,0,12" />

                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" FlowDirection="RightToLeft">
                                    <TextBlock Text="سرویس‌دهنده"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding Providers}"
                                              SelectedItem="{Binding SelectedProvider}"
                                              Style="{StaticResource ModernComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" FlowDirection="RightToLeft">
                                    <TextBlock Text="مدل (ورود دستی)"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding AvailableModels}"
                                              Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              Style="{StaticResource ModernComboBoxStyle}" />
                                    <Button Content="دریافت مدل‌ها"
                                            Command="{Binding LoadModelsCommand}"
                                            IsEnabled="{Binding IsLoadingModels, Converter={StaticResource InverseBooleanConverter}}"
                                            Style="{StaticResource TextButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Padding="7,3"
                                            MinHeight="26"
                                            Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Authentication -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="13"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="احراز هویت"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="کلید API در حافظه‌ی امن ویندوز ذخیره می‌شود."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="کلید API"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     FontFamily="Consolas"
                                     Margin="0,0,0,11"
                                     ToolTip="کلید API سرویس انتخاب‌شده" />

                            <TextBlock Text="Base URL / آدرس واسطه (اختیاری)"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     FontFamily="Consolas"
                                     ToolTip="مثلاً https://openrouter.ai/api/v1 یا http://localhost:11434/v1" />
                            <TextBlock Text="برای OpenAI-compatible مثل OpenRouter، LiteLLM، Ollama و LM Studio، آدرس را تا /v1 وارد کنید."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,7,0,0" />

                            <Grid Margin="0,12,0,0" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="بررسی اتصال"
                                        Command="{Binding TestConnectionCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBooleanConverter}}"
                                        Padding="12,7" />
                                <Border Grid.Column="1"
                                        Background="{StaticResource InputBgBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="9,0,0,0"
                                        Padding="9,6"
                                        MinHeight="34">
                                    <TextBlock Text="{Binding ConnectionStatusMessage}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnectionSuccess}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Safety -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="13"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="حریم خصوصی و ایمنی"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="کنترل کنید چه چیزی ارسال شود و کدام عملیات نیاز به تأیید داشته باشد."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,3,0,12" />
                            <CheckBox IsChecked="{Binding SendDrawingContext}"
                                      Content="ارسال وضعیت نقشه برای پاسخ دقیق‌تر"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      Margin="0,0,0,12" />
                            <CheckBox IsChecked="{Binding RequireConfirmationForDestructiveOps}"
                                      Content="تأیید قبل از حذف یا تغییر آبجکت‌ها"
                                      Style="{StaticResource ModernCheckBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Display -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="13">
                        <StackPanel>
                            <TextBlock Text="ترجیحات نمایش"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,0,12" />
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" FlowDirection="RightToLeft">
                                    <TextBlock Text="زبان"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding Languages}"
                                              SelectedItem="{Binding SelectedLanguage}"
                                              Style="{StaticResource ModernComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" FlowDirection="RightToLeft">
                                    <TextBlock Text="تم"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding Themes}"
                                              SelectedItem="{Binding SelectedTheme}"
                                              Style="{StaticResource ModernComboBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Sticky footer -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,13,0,0"
                    Margin="0,13,0,0">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1"
                            Content="انصراف"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="78" />
                    <Button Grid.Column="3"
                            Content="ذخیره تغییرات"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="122" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
